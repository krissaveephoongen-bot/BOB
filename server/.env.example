# Copy to .env (git-ignored) next to docker-compose.yml, then: docker compose up -d
# The file is only read by docker compose: nothing here is compiled into the game.
POSTGRES_DB=nakama
POSTGRES_PASSWORD=localdb

# LINE Login (docs 28). The channel ID is public; the secret is not - keep it here, never in the repo or the APK.
# Leave both empty to run without LINE (the button then shows the server as not configured).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Must match the redirect URI registered in the LINE console, character for character.
LINE_REDIRECT_URI=bob://line-login
