# Copy to .env (git-ignored) next to docker-compose.yml and fill every value. Never commit .env.
POSTGRES_DB=nakama
POSTGRES_PASSWORD=change-me-long-random

# Nakama admin console (port 7351, reachable only inside the docker network)
NAKAMA_CONSOLE_USER=admin
NAKAMA_CONSOLE_PASSWORD=change-me-too

# Server key the game sends (BobServer / Settings). Keep defaultkey for the first test; change it and the client together.
NAKAMA_SERVER_KEY=defaultkey
NAKAMA_LOG_LEVEL=INFO

# Domain for Caddy. With a domain (DuckDNS is free) it gets a real certificate; with only an IP use ":80".
SITE_ADDRESS=bob-example.duckdns.org
